stream {
  upstream jitsi_video {
    hash $remote_addr consistent;
    server 10.0.196.12:10000;
  }
  server {
    listen 10000 udp reuseport;
    proxy_timeout 20s;
    proxy_pass jitsi_video;
  }


# NTP Start
  upstream ntp {
    hash $remote_addr consistent;
    server 10.0.197.159:123;
  }
  server {
    listen 123 udp reuseport;
    proxy_timeout 20s;
    proxy_pass ntp;
  }
# NTP End

# START SSL parse for routing

log_format basic '$remote_addr [$time_local] '
                 '$protocol $status $bytes_sent $bytes_received '
                 '$session_time'
		 ' $ssl_preread_alpn_protocols'
		 ' $ssl_preread_server_name'
		 ' $ssl_preread_protocol';

access_log /dev/stdout basic;


  # check ALPN for xmpp client or server and redirect to local ssl termination endpoints
    map $ssl_preread_alpn_protocols $upstream_by_proto {
#        "identifyssh"     127.0.0.1:8022;
        "identifyssh"     100.0.69.1:22;
#	"xmpp-client"     127.0.0.1:5422;
#        "xmpp-server"     127.0.0.1:5469;
        default           127.0.0.1:8443; # openvpn
    }

    map $ssl_preread_server_name $upstream_sn {
        "burianov.wales" 127.0.0.1:443;
        default           $upstream_by_proto;
    }

    map $ssl_preread_protocol $upstream {
        default $upstream_by_proto;
        "TLSv1.2" web;
	"TLSv1.3" web;
    }

    upstream web {
        server 127.0.0.1:443;
    }

    # Traffic director server
    server {
        # listen 2443 proxy_protocol;
        listen 2443;
        ssl_preread on;
        #proxy_ssl off;
        proxy_pass $upstream;
        # proxy_protol breaks mtproxy, it does not support variable
        # see above for the solution
        # proxy_protocol on;
        set_real_ip_from  172.16.0.0/12;
    }

    # TLS termination for SSH connections
#    server {
#        listen 8022 ssl;
#        ssl_certificate /etc/ssl/certs/nginx-selfsigned.crt;
#        ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;
#        ssl_dhparam /etc/ssl/certs/dhparam.pem;
#        proxy_ssl off;
#        proxy_pass 100.0.69.1:22;
#    }

# ENT SSL parse for routing

